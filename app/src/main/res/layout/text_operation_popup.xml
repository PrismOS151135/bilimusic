<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="90dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="1dp">

    <!-- 复制按钮 -->
    <TextView
        android:id="@+id/popup_copy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="90dp"
        android:padding="12dp"
        android:text="@string/t5"
        android:textSize="14sp"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:background="?android:attr/selectableItemBackground" />

    <!-- 剪切按钮 -->
    <TextView
        android:id="@+id/popup_cut"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="90dp"
        android:padding="12dp"
        android:text="@string/t4"
        android:textSize="14sp"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:background="?android:attr/selectableItemBackground" />

    <!-- 粘贴按钮 -->
    <TextView
        android:id="@+id/popup_paste"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="90dp"
        android:padding="12dp"
        android:text="@string/t3"
        android:textSize="14sp"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:background="?android:attr/selectableItemBackground" />

    <!-- 全选按钮 -->
    <TextView
        android:id="@+id/popup_select_all"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="90dp"
        android:padding="12dp"
        android:text="@string/t6"
        android:textSize="14sp"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:background="?android:attr/selectableItemBackground" />

    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray" />

    <!-- 取消按钮 -->
    <TextView
        android:id="@+id/popup_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="90dp"
        android:padding="12dp"
        android:text="@string/t7"
        android:textSize="14sp"
        android:textColor="@android:color/black"
        android:gravity="center"
        android:background="?android:attr/selectableItemBackground" />

</LinearLayout>